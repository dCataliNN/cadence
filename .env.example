# Identifies this app to Audius. Audius asks third-party apps to send an app name
# with every request; it is public (it appears in stream URLs) so it is not a secret.
NEXT_PUBLIC_AUDIUS_APP_NAME=Cadence

# Optional: override the Audius API host (defaults to https://api.audius.co).
# AUDIUS_API_BASE_URL=https://api.audius.co

# Optional: canonical site URL for social preview links. On Vercel this falls back
# to the production domain automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
